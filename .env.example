# ---------------------------------------------------------------------------
# SmokeTrace environment variables
# Copy this file to `.env.local` and fill in your own values.
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable / anon key
# (Project Settings -> API Keys -> Publishable key, or the legacy "anon public" key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of the app. Use http://localhost:3000 in development,
# or your deployed URL in production (e.g. https://smoketrace.vercel.app).
# Used for auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Supabase service-role (secret) key. SERVER ONLY — never expose it.
# The app does not currently use this; only set it if you add server-side
# features that must bypass row-level security.
# SUPABASE_SERVICE_ROLE_KEY=
